# Copy to .env.local. Never commit .env.local.
#
# Nothing here is NEXT_PUBLIC_ on purpose: every value below is a server secret
# and must never be inlined into the browser bundle.

SUPABASE_URL=https://xxxx.supabase.co

# Project Settings → API → service_role. This key bypasses ALL row level
# security. It is read only by src/lib/db.ts, which is marked server-only.
SUPABASE_SERVICE_ROLE_KEY=xxxx

# Encrypts TOTP secrets at rest, so a database dump is not a 2FA bypass.
# Generate with: openssl rand -base64 32
# Rotating this invalidates every enrolled authenticator.
ADMIN_TOTP_ENC_KEY=xxxx
